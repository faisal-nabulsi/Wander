+
+extension ALTAppleAPI {
+    /// Apple's edge in front of gsa.apple.com serves at most two requests per connection and answers
+    /// the rest with HTTP 429 (it was a 503 when first reported, around 2026-08-31). Signing in is three
+    /// requests (init, complete, apptokens) and 2FA adds two more, so any of them sharing a pooled
+    /// connection can be refused. `session` is one ephemeral URLSession on a singleton, and `.ephemeral`
+    /// only turns off on-disk storage - it still reuses keep-alive connections. So every gsa.apple.com
+    /// request gets its own session, and therefore its own connection. Mirrors rileytestut/AltSign#52.
+    /// Calls to developerservices2.apple.com keep using the shared `session`.
+    fileprivate static func makeOneShotGSASession() -> URLSession {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.httpMaximumConnectionsPerHost = 1
+        return URLSession(configuration: configuration)
+    }
+}
